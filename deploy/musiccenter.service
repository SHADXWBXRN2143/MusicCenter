[Unit]
Description=MusicCenter
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/MusicCenter
EnvironmentFile=/home/admin/MusicCenter/.env
ExecStart=/home/admin/MusicCenter/venv/bin/gunicorn --workers 1 --threads 4 --bind 0.0.0.0:5000 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
