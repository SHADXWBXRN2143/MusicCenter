# Скопируйте в .env и заполните реальными значениями.
# .env в .gitignore - секреты сюда, не в config.py.

AIRSONIC_URL=http://192.168.1.102:8383
AIRSONIC_USERNAME=admin
AIRSONIC_PASSWORD=

PLAYER_DEFAULT_VOLUME=70

# Аудиовыход mpv. "alsa" по умолчанию - под systemd нет доступа к
# пользовательской сессии PipeWire/PulseAudio. Если запускаете mpv
# руками в терминале (не как systemd-сервис), можно поставить "pulse"
# или "pipewire". Для конкретной карты: "alsa/hw:1,0" (см. `aplay -l`).
PLAYER_AUDIO_OUTPUT=alsa

# Telegram bot (bot/main.py) - токен от @BotFather и через запятую
# Telegram ID всех, кому разрешено управлять ботом (свой узнать
# можно у @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=

# Длительность фейд-перехода (сек) в начале/конце каждого трека, вместе
# с mpv --gapless-audio даёт эффект кроссфейда без риска для стабильности.
PLAYER_FADE_SECONDS=2.5

# Живая (не декоративная) спектрограмма - выключена по умолчанию, ничего
# не меняет, пока не заполнено. Нужен ALSA-loopback на хосте (см. README,
# раздел "Живая спектрограмма") и пакеты numpy + pyalsaaudio (НЕ входят в
# requirements.txt - опциональная установка, см. README).
SPECTRUM_CAPTURE_DEVICE=
SPECTRUM_GAIN=4000

# Last.fm-скробблинг - выключен, пока не задан LASTFM_SESSION_KEY. API_KEY
# и API_SECRET берутся на last.fm/api (бесплатно), SESSION_KEY получается
# один раз через `python scripts/lastfm_auth.py` (см. README).
LASTFM_API_KEY=
LASTFM_API_SECRET=
LASTFM_SESSION_KEY=
