# Скопируйте в .env и заполните реальными значениями.
# .env в .gitignore - секреты сюда, не в config.py.

AIRSONIC_URL=http://192.168.1.102:8383
AIRSONIC_USERNAME=admin
AIRSONIC_PASSWORD=

PLAYER_DEFAULT_VOLUME=70

# Аудиовыход mpv. "alsa" по умолчанию - под systemd нет доступа к
# пользовательской сессии PipeWire/PulseAudio. Если запускаете mpv
# руками в терминале (не как systemd-сервис), можно поставить "pulse"
# или "pipewire". Для конкретной карты: "alsa/hw:1,0" (см. `aplay -l`).
PLAYER_AUDIO_OUTPUT=alsa

# Telegram bot (bot/main.py) - токен от @BotFather и через запятую
# Telegram ID всех, кому разрешено управлять ботом (свой узнать
# можно у @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
